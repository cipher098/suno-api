# For more information, please see the README.md
SUNO_COOKIE=
# Obtain a solver key from 2captcha.com only if using browser solving.
TWOCAPTCHA_KEY=
# Browser choice for the optional browser path.
BROWSER=chromium
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
BROWSER_HEADLESS=true
# Studio browser fallback is opt-in; requires browser runtime and solver credentials.
SUNO_STUDIO_BROWSER_FALLBACK=false
